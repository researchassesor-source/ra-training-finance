# Backend privado utilizado por api/proxy.js
GAS_URL=

# Dominio publico utilizado por los codigos QR
VITE_PUBLIC_APP_URL=

# Desactivado por defecto. El proveedor fiscal se elige explícitamente por entorno.
VITE_ENABLE_SRI_BILLING=false
VITE_FISCAL_API_URL=http://127.0.0.1:4010
VITE_FISCAL_RUNTIME_CONTEXT=auto
VITE_FISCAL_PREVIEW_DEMO=false
VITE_FISCAL_USE_EXISTING_APP_DATA=false

# Para Preview no establezcas VITE_FISCAL_API_URL ni VITE_LOCAL_FISCAL_DEMO_AUTH.
# Consulta .env.preview.example. Ninguna variable de ejemplo contiene secretos.
