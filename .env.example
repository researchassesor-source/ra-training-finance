# Backend privado utilizado por api/proxy.js
GAS_URL=

# development | preview | production
VITE_DEPLOYMENT_ENV=development

# Dominio publico utilizado por los codigos QR
VITE_PUBLIC_APP_URL=

# pending | configured. Production debe usar configured para certificados con aval.
VITE_CERTIFICATE_AVAL_VISUAL_MODE=pending

# Origenes externos autorizados para el proxy, separados por coma.
# El mismo origen se permite automaticamente.
ALLOWED_ORIGINS=
