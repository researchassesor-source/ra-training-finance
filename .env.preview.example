# Solo para despliegues Preview. No copiar a Production. No contiene secretos.
# No establecer VITE_FISCAL_API_URL: la demostración no utiliza un backend fiscal.
# No establecer VITE_LOCAL_FISCAL_DEMO_AUTH: se usa el inicio de sesión normal.
VITE_ENABLE_SRI_BILLING=true
VITE_FISCAL_RUNTIME_CONTEXT=preview
VITE_FISCAL_PREVIEW_DEMO=true
VITE_FISCAL_USE_EXISTING_APP_DATA=false
