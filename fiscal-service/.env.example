NODE_ENV=development
TZ=America/Guayaquil
FISCAL_HOST=127.0.0.1
FISCAL_PORT=4010
FISCAL_LOCAL_DEV_MODE=true
FISCAL_STORAGE=inmemory
FISCAL_MOCK_SRI_SCENARIO=AUTHORIZED
FISCAL_MAX_RETRIES=3
FISCAL_RETRY_BACKOFF_MS=250
FISCAL_SRI_REAL_CONNECTION_ENABLED=false
DATABASE_URL=postgresql://fiscal_local:fiscal_local@127.0.0.1:5434/ra_training_fiscal
