NODE_ENV=development
TZ=America/Guayaquil
FISCAL_HOST=127.0.0.1
FISCAL_PORT=4010
FISCAL_LOCAL_DEV_MODE=true
FISCAL_STORAGE=inmemory
FISCAL_MOCK_SRI_SCENARIO=AUTHORIZED
FISCAL_MAX_RETRIES=3
FISCAL_RETRY_BACKOFF_MS=250
FISCAL_SRI_REAL_CONNECTION_ENABLED=false
FISCAL_SRI_CONFIRM_REAL_CALL=false
FISCAL_MASK_PRIVATE_DATA_IN_EVIDENCE=true
FISCAL_SRI_ENVIRONMENT=CERTIFICATION
FISCAL_XADES_SIGNER=mock
FISCAL_CERT_PATH=
FISCAL_CERT_PASSWORD=
FISCAL_CERT_ALIAS=
FISCAL_ISSUER_RUC=9999999999001
FISCAL_ISSUER_BUSINESS_NAME=EMPRESA FICTICIA DE CAPACITACION S.A.S.
FISCAL_ISSUER_TRADE_NAME=AULA DEMO LOCAL
FISCAL_ISSUER_CITY=CIUDAD DEMO
FISCAL_ISSUER_PHONE=0990000000
FISCAL_ISSUER_EMAIL=fiscal@example.test
FISCAL_ESTABLISHMENT_CODE=001
FISCAL_EMISSION_POINT_CODE=001
FISCAL_HEAD_OFFICE_ADDRESS=PENDING_CONFIRMATION
FISCAL_ESTABLISHMENT_ADDRESS=PENDING_CONFIRMATION
FISCAL_ACCOUNTING_OBLIGATION=PENDING_CONFIRMATION
FISCAL_SPECIAL_TAXPAYER_CODE=
FISCAL_RETENTION_AGENT=PENDING_CONFIRMATION
FISCAL_REGIME_INFORMATION=PENDING_CONFIRMATION
FISCAL_SEQUENCE_START=PENDING_CONFIRMATION
FISCAL_SENDER_EMAIL=fiscal@example.test
DATABASE_URL=postgresql://fiscal_local:fiscal_local@127.0.0.1:5434/ra_training_fiscal
