{
  "name": "ra-training-fiscal-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "test:postgres-memory": "vitest run tests/postgres-memory.test.ts",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed.ts",
    "migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.10.1",
    "fastify": "^5.10.0",
    "node-forge": "^1.4.0",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/node-forge": "^1.3.14",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.15.6",
    "eslint": "^9.39.1",
    "pg-mem": "^3.0.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
